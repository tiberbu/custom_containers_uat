ARG FRAPPE_BRANCH=version-15

FROM frappe/build:${FRAPPE_BRANCH} AS builder

ARG FRAPPE_BRANCH=version-15
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG APPS_JSON_BASE64

USER root
RUN groupadd -f frappe && mkdir -p /opt/frappe && chown frappe:frappe /opt/frappe

USER frappe

RUN if [ -n "${APPS_JSON_BASE64}" ]; then \
      echo "${APPS_JSON_BASE64}" | base64 -d > /opt/frappe/apps.json; \
    fi && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

# Remove esbuild build binary — not needed in production image
RUN find /home/frappe/frappe-bench/apps -name "esbuild" -type f -delete

FROM frappe/base:${FRAPPE_BRANCH} AS backend

USER root

# Security patch layer — upgrades OS packages with known CVEs in the base image.
# This file is used for security-test builds only.
# Do NOT replace images/custom/Containerfile with this without team approval.
RUN apt-get update -qq && \
    apt-get install -y --only-upgrade --no-install-recommends \
      perl perl-base perl-modules-5.36 libperl5.36 \
      libexpat1 \
      libssl3 libssl-dev openssl \
      libpng16-16 \
      libbrotli1 \
      tar && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Remove packages not required for production Frappe backend
# - vim: text editor, zero runtime purpose in production
# - chromium: Frappe uses wkhtmltopdf for PDF, not Chromium
# - libjq1: JSON query library, not used by Frappe core
RUN apt-get remove -y --purge \
      vim vim-common vim-runtime vim-tiny \
      chromium-common chromium-headless-shell \
      libjq1 2>/dev/null || true && \
    apt-get autoremove -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

# Upgrade Python packages with known CVEs
RUN /home/frappe/frappe-bench/env/bin/pip install --upgrade \
      "PyJWT>=2.14.0" \
      "certifi>=2026.10.18" \
      "weasyprint>=70.0" \
      "pypdf>=6.19.0" \
      "Werkzeug>=3.1.9" \
      "oauthlib>=4.0.0" \
      "wheel>=0.46.2" \
      "Pillow>=13.0.0" \
      "GitPython>=3.2.1" \
      "msgpack>=1.2.1" \
      "urllib3>=2.8.0" \
      "filelock>=4.2.1" \
      "setuptools>=78.1.1"

# Upgrade vulnerable Node.js packages in Frappe frontend
RUN . /home/frappe/.nvm/nvm.sh && \
    cd /home/frappe/frappe-bench/apps/frappe && \
    npm install --save-exact \
      brace-expansion@2.1.5 \
      postcss@8.5.18 \
      nanoid@3.3.12 \
      minimatch@10.2.1 \
      browserslist@4.28.7 \
      ws@8.21.0 \
      shell-quote@1.9.0 \
      form-data@4.0.6 \
      loader-utils@2.0.3 \
      socket.io-parser@4.2.6 \
      svgo@3.3.5 2>/dev/null || true

# Fix nested vulnerable packages and remove all esbuild binaries
# Note: esbuild delete is ALWAYS last — npm install reinstalls it as a transitive dep
RUN rm -rf /home/frappe/frappe-bench/apps/frappe/node_modules/generic-names/node_modules/loader-utils && \
    . /home/frappe/.nvm/nvm.sh && \
    cd /home/frappe/frappe-bench/apps/frappe && \
    npm install --save-exact \
      loader-utils@2.0.4 \
      shell-quote@1.11.0 2>/dev/null || true && \
    rm -rf /home/frappe/frappe-bench/apps/frappe/node_modules/esbuild \
           /home/frappe/frappe-bench/apps/frappe/node_modules/esbuild-linux-64 \
           /home/frappe/frappe-bench/apps/frappe/node_modules/esbuild-linux-32 \
           /home/frappe/frappe-bench/apps/frappe/node_modules/esbuild-linux-arm64 \
           /home/frappe/frappe-bench/apps/frappe/node_modules/esbuild-linux-arm \
           /home/frappe/frappe-bench/apps/frappe/node_modules/@esbuild && \
    find /home/frappe/frappe-bench/apps -name "esbuild" -type f -delete 2>/dev/null || true

USER frappe

WORKDIR /home/frappe/frappe-bench

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/sites/assets", \
  "/home/frappe/frappe-bench/logs" \
]

CMD [ \
  "/home/frappe/frappe-bench/env/bin/gunicorn", \
  "--chdir=/home/frappe/frappe-bench/sites", \
  "--bind=0.0.0.0:8000", \
  "--threads=4", \
  "--workers=2", \
  "--worker-class=gthread", \
  "--worker-tmp-dir=/dev/shm", \
  "--timeout=120", \
  "--preload", \
  "frappe.app:application" \
]
